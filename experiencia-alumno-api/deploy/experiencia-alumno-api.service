# Servicio systemd: el backend arranca solo al encender la EC2 y se reinicia si se cae.
# Instalar:
#   sudo cp deploy/experiencia-alumno-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now experiencia-alumno-api
# Ver logs:
#   sudo journalctl -u experiencia-alumno-api -f

[Unit]
Description=Experiencia Alumno API (Spring Boot)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/experiencia-alumno-api
EnvironmentFile=/etc/experiencia-alumno.env
ExecStart=/usr/bin/java -Xmx384m -jar target/experiencia-alumno-api-1.0.0.jar
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
