# Copiar a /etc/experiencia-alumno.env en la EC2 y completar los valores reales:
#   sudo cp deploy/experiencia-alumno.env.ejemplo /etc/experiencia-alumno.env
#   sudo nano /etc/experiencia-alumno.env
#   sudo chmod 600 /etc/experiencia-alumno.env
# Este archivo de ejemplo NO contiene secretos reales.

SPRING_PROFILES_ACTIVE=prod
DB_NAME=experiencia_alumno
DB_USER=experiencia_user
DB_PASSWORD=CAMBIAR_PASSWORD
# Clave para firmar los JWT: minimo 32 caracteres. Generar con:  openssl rand -base64 48
JWT_SECRET=CAMBIAR_POR_UNA_CLAVE_LARGA_Y_ALEATORIA_DE_32_O_MAS_CARACTERES
# Origen del frontend (si Nginx sirve frontend y API en la misma IP, CORS casi no se usa)
CORS_ORIGINS=http://localhost:5173,http://IP_PUBLICA_EC2
